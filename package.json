{
  "name": "@letterblack/lbe-core",
  "version": "1.4.0",
  "description": "Offline execution-decision and proof SDK for host-routed AI agent actions.",
  "type": "module",
  "main": "dist/index.js",
  "types": "types.d.ts",
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": "./dist/cli.js"
  },
  "bin": {
    "lbe": "dist/cli.js"
  },
  "files": [
    "dist/",
    "assets/",
    "docs/decisions/*.md",
    "types.d.ts",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "pack": "npm pack",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run pack:check"
  },
  "keywords": [
    "ai-governance",
    "execution-governance",
    "agent-safety",
    "policy-engine",
    "audit-log",
    "offline",
    "local-first"
  ],
  "author": "LetterBlack",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {},
  "engines": {
    "node": ">=20.9.0"
  }
}
